VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sin prefijo VITE_ a propósito: esta sí es secreta y no debe llegar nunca
# al navegador. Solo la usan api/partidos.js, api/jugadores.js, api/partido.js
# y api/cuotas.js (Serverless Functions de Vercel).
API_FOOTBALL_KEY=

# Sin prefijo VITE_ a propósito: solo la usan las Serverless Functions
# (limitador de peticiones a API-Football y caché de plantillas de equipo),
# nunca debe llegar al navegador. Supabase > Project Settings > API >
# service_role.
SUPABASE_SERVICE_ROLE_KEY=
