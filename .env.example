VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sin prefijo VITE_ a propósito: esta sí es secreta y no debe llegar nunca
# al navegador. Solo la usa api/partidos.js (Serverless Function de Vercel).
API_FOOTBALL_KEY=

# Bot de Telegram (api/telegram-webhook.js) — resolver apuestas pendientes
# sin abrir la app. Ninguna lleva prefijo VITE_: las cinco son de servidor.
#
# - SUPABASE_SERVICE_ROLE_KEY: Supabase > Project Settings > API > service_role.
#   Salta el RLS (acceso total a la base de datos) — solo la usa este webhook,
#   nunca debe llegar al navegador.
# - SUPABASE_USER_ID: tu UUID de usuario, Supabase > Authentication > Users.
# - TELEGRAM_BOT_TOKEN: token que te da @BotFather al crear el bot.
# - TELEGRAM_WEBHOOK_SECRET: cadena aleatoria inventada por ti (p.ej.
#   generada con `openssl rand -hex 24`); se manda a Telegram al registrar
#   el webhook (setWebhook) y Telegram la reenvía en cada petición — así se
#   descarta cualquier POST que no venga realmente de Telegram.
# - TELEGRAM_OWNER_ID: tu ID numérico de Telegram (pregúntaselo a
#   @userinfobot); el bot ignora cualquier mensaje que no sea tuyo.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=

# Aviso de "partido terminado" (api/telegram-avisos.js) — cadena aleatoria
# inventada por ti (p.ej. `openssl rand -hex 24`), distinta de las de
# arriba: la comprueba un cron EXTERNO gratuito (cron-job.org), no Telegram,
# así que no puede usar el mismo secret_token del webhook. Va como
# parámetro en la URL que configures en cron-job.org: .../api/telegram-avisos?secret=<esto>
AVISOS_CRON_SECRET=

# Aviso de "apuesta registrada" (api/telegram-registro.js) — cadena aleatoria
# inventada por ti, distinta de las de arriba: la comprueba un Database
# Webhook de Supabase (Database > Webhooks, se configura a mano en el panel,
# evento INSERT en la tabla "apuestas"), no Telegram ni cron-job.org. Se
# manda como cabecera HTTP personalizada al configurar el webhook en
# Supabase: X-Registro-Secret: <esto>
REGISTRO_WEBHOOK_SECRET=

# Limpieza diaria del chat de Telegram, 8-9h hora de España
# (api/telegram-limpieza.js) — cadena aleatoria inventada por ti, distinta
# de las de arriba: mismo mecanismo que AVISOS_CRON_SECRET (un cron EXTERNO
# gratuito, cron-job.org, cada 15 min), pero un trabajo aparte con su propio
# secreto. Va como parámetro en la URL: .../api/telegram-limpieza?secret=<esto>
LIMPIEZA_CRON_SECRET=
