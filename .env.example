VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sin prefijo VITE_ a propósito: esta sí es secreta y no debe llegar nunca
# al navegador. Proveedor activo desde el 2026-09-03 (migración de
# API-Football a GOAL API, ver CHANGELOG.md) — la usan api/partidos.js,
# api/jugadores.js y api/partido.js (Serverless Functions de Vercel).
GOAL_API_KEY=

# Sin prefijo VITE_ a propósito: esta sí es secreta y no debe llegar nunca
# al navegador. Ya NO la usa ningún endpoint activo (proveedor en pausa,
# ver api/_lib/proveedorApiFootball/) — se deja aquí por si la cuenta de
# API-Football se reactiva algún día.
API_FOOTBALL_KEY=

# Sin prefijo VITE_ a propósito: solo la usan las Serverless Functions
# (limitador de peticiones a GOAL API y caché de plantillas de equipo),
# nunca debe llegar al navegador. Supabase > Project Settings > API >
# service_role.
SUPABASE_SERVICE_ROLE_KEY=
